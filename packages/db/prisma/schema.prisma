generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  photoUrl String?

  candidate    Candidate?
  recruiter    Recruiter?
  ownedCompany Company?

  emailVerified Boolean   @default(false)
  image         String?
  sessions      Session[]
  accounts      Account[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Candidate {
  id      String @id @default(cuid())
  credits Int    @default(100)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  interviews         CompanyInterview[]
  invitations        Invitation[]
  resumes            Resume[]
  practiceInterviews PracticeInterview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Company {
  id      String @id @default(cuid())
  credits Int    @default(100)

  name    String  @unique
  website String?
  logoUrl String?

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  recruiterInvitations RecruiterInvitation[]
  recruiters           Recruiter[]
  jobs                 Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecruiterInvitation {
  token     String           @id
  email     String
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([companyId])
}

model Recruiter {
  id          String  @id @default(cuid())
  designation String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobRecruiters JobRecruiter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Job {
  id                 String    @id @default(cuid())
  title              String
  description        String    @db.Text
  status             JobStatus @default(DRAFT)
  minExperienceYears Int
  maxExperienceYears Int?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  interviews      CompanyInterview[]
  jobRecruiters   JobRecruiter[]
  invitations     Invitation[]
  interviewConfig InterviewConfig?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
}

model JobRecruiter {
  jobId       String
  recruiterId String

  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recruiter Recruiter @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([jobId, recruiterId])
  @@index([recruiterId])
  @@index([jobId])
}

model CompanyInterview {
  id          String          @id @default(cuid())
  status      InterviewStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  questions   CompanyQuestion[]
  invitations Invitation[]
  report      CompanyInterviewReport?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@index([jobId])
  @@index([status])
}

model CompanyInterviewReport {
  id             String   @id @default(cuid())
  overallScore   Int
  strengths      String[]
  weaknesses     String[]
  summary        String   @db.Text
  recommendation String?  @db.Text

  interviewId String           @unique
  interview   CompanyInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InterviewConfig {
  id              String        @id @default(cuid())
  questionCount   Int
  interviewMode   InterviewMode
  durationMinutes Int
  prompt          String?       @db.Text

  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyQuestion {
  id                 String     @id @default(cuid())
  questionText       String
  difficulty         Difficulty
  timeLimitSeconds   Int        @default(60)
  userAnswer         String?    @db.Text
  aiFeedback         String?    @db.Text
  questionScore      Int        @default(0)
  confidenceScore    Int        @default(0)
  communicationScore Int        @default(0)
  correctnessScore   Int        @default(0)
  durationSeconds    Int?
  category           String?
  displayOrder       Int
  isAnswered         Boolean    @default(false)

  interviewId String
  interview   CompanyInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([interviewId, displayOrder])
  @@index([interviewId])
}

model Invitation {
  id         String           @id @default(cuid())
  token      String           @unique
  expiresAt  DateTime
  status     InvitationStatus @default(PENDING)
  acceptedAt DateTime?

  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  candidateEmail String
  candidateName  String?

  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interviewId String?
  interview   CompanyInterview? @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateEmail])
  @@index([candidateId])
  @@index([jobId])
  @@index([status])
}

model PracticeInterview {
  id              String          @id @default(cuid())
  role            String
  interviewMode   InterviewMode
  experienceYears Int
  status          InterviewStatus @default(PENDING)
  startedAt       DateTime?
  completedAt     DateTime?

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  resumeId String?
  resume   Resume? @relation(fields: [resumeId], references: [id])

  report PracticeInterviewReport?

  questions PracticeQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@index([status])
}

model Resume {
  id       String @id @default(cuid())
  fileName String
  fileUrl  String

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  interviews     PracticeInterview[]
  resumeAnalysis ResumeAnalysis?     @relation("ResumeToAnalysis")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@index([createdAt])
}

model ResumeAnalysis {
  id              String   @id @default(cuid())
  name            String
  email           String?
  skills          String[]
  projects        Json[]
  experienceyears Int?
  education       Json[]
  suggestedRoles  String[]
  summary         String   @db.Text

  resumeId String @unique
  resume   Resume @relation("ResumeToAnalysis", fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeId])
}

model PracticeQuestion {
  id                 String     @id @default(cuid())
  questionText       String
  difficulty         Difficulty
  timeLimitSeconds   Int        @default(60)
  userAnswer         String?    @db.Text
  aiFeedback         String?    @db.Text
  questionScore      Int        @default(0)
  confidenceScore    Int        @default(0)
  communicationScore Int        @default(0)
  correctnessScore   Int        @default(0)
  durationSeconds    Int?
  category           String?
  displayOrder       Int
  isAnswered         Boolean    @default(false)

  interviewId String
  interview   PracticeInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([interviewId, displayOrder])
  @@index([interviewId])
}

model PracticeInterviewReport {
  id             String   @id @default(cuid())
  overallScore   Int
  strengths      String[]
  weaknesses     String[]
  summary        String   @db.Text
  recommendation String?  @db.Text

  interviewId String            @unique
  interview   PracticeInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum InterviewMode {
  TECHNICAL
  HR
}

enum InterviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
  CANCELLED
}

enum JobStatus {
  OPEN
  PAUSED
  CLOSED
  DRAFT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}
